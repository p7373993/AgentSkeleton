AZURE_EXISTING_AIPROJECT_ENDPOINT="https://my-ai-llama-test-resource.openai.azure.com/openai/v1"
AZURE_OPENAI_DEPLOYMENT="gpt-5.4-mini"

# Optional Azure project metadata.
AZURE_ENV_NAME="models-playground-2051"
