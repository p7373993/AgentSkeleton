AZURE_SUBSCRIPTION_ID="e4af758a-5898-4e49-8de0-e3b53bf68fa4"
AZURE_EXISTING_AIPROJECT_RESOURCE_ID="/subscriptions/e4af758a-5898-4e49-8de0-e3b53bf68fa4/resourceGroups/rg-llama_test/providers/Microsoft.CognitiveServices/accounts/my-ai-llama-test-resource/projects/llama_test"
