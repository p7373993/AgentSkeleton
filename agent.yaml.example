model: gpt-5.5
# Azure/OpenAI-compatible v1 base URL. You can also set OPENAI_BASE_URL,
# AZURE_OPENAI_ENDPOINT, or AZURE_EXISTING_AIPROJECT_ENDPOINT.
# If you paste a full .../responses endpoint, the app normalizes it to .../v1/.
base_url: null
reasoning_effort: low
text_verbosity: low
max_steps: 20
workspace: "."
confirm_risky_actions: true
logs_dir: "runs"
shell_timeout_seconds: 30
shell_max_output_bytes: 20000
# Optional allowlist for the tools exposed to the model.
# Leave null to enable all default tools.
enabled_tools: null
# enabled_tools:
#   - list_dir
#   - read_file
#   - ask_user
